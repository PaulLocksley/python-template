stages:
  - check
{%- if not is_library %}
  - build
{%- endif %}
  - release

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_COMMIT_TAG

variables:
  UV_CACHE_DIR: $CI_PROJECT_DIR/.cache/uv
  UV_LINK_MODE: copy
  # hatch-vcs derives the version from git tags, so it needs the history.
  GIT_DEPTH: 0

default:
  image: ghcr.io/astral-sh/uv:python3.14-bookworm-slim
  interruptible: true

.python:
  stage: check
  cache:
    key:
      files: [uv.lock]
    paths: [.cache/uv]
  before_script:
    - uv sync --locked
  after_script:
    - uv cache prune --ci

lint:
  extends: .python
  script:
    - uv run just lint

typecheck:
  extends: .python
  script:
    - uv run just typecheck

architecture:
  extends: .python
  script:
    - uv run just arch

test:
  extends: .python
{%- if is_django %}
  services:
    - name: postgres:18
      alias: postgres
  variables:
    POSTGRES_USER: {{ package_name }}
    POSTGRES_PASSWORD: {{ package_name }}
    POSTGRES_DB: {{ package_name }}
    DATABASE_URL: postgres://{{ package_name }}:{{ package_name }}@postgres:5432/{{ package_name }}
{%- endif %}
  script:
    - uv run just test -n auto --junitxml=report.xml --cov-report=xml
  coverage: '/^TOTAL.+?(\d+(?:\.\d+)?%)$/'
  artifacts:
    when: always
    reports:
      junit: report.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

audit:
  extends: .python
  script:
    - uv run just audit
{%- if is_django %}

django-check:
  extends: .python
  # The production settings check reads the Vite manifest.
  needs:
    - job: frontend
      artifacts: true
  services:
    - name: postgres:18
      alias: postgres
  variables:
    POSTGRES_USER: {{ package_name }}
    POSTGRES_PASSWORD: {{ package_name }}
    POSTGRES_DB: {{ package_name }}
    DATABASE_URL: postgres://{{ package_name }}:{{ package_name }}@postgres:5432/{{ package_name }}
  script:
    - uv run just django-check

frontend:
  stage: check
  image: node:24-slim
  cache:
    key:
      files: [pnpm-lock.yaml]
    paths: [.cache/pnpm]
  before_script:
    - corepack enable
    - pnpm config set store-dir .cache/pnpm
    - pnpm install --frozen-lockfile
  script:
    - pnpm exec biome ci
    - pnpm exec tsc --noEmit
    - pnpm exec vite build
  artifacts:
    paths: [frontend/dist]
    expire_in: 1 day
{%- endif %}
{%- if not is_library %}

# Builds on every pipeline so a broken Dockerfile is caught in review, but only
# pushes from the default branch (as :latest and :<sha>) and from tags (as :<tag>).
image:
  stage: build
  image: docker:28
  services:
    - docker:28-dind
  variables:
    DOCKER_TLS_CERTDIR: /certs
  before_script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login --username "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
  script:
    - docker build --pull{% if is_cli %} --build-arg "VERSION=${CI_COMMIT_TAG:-0.0.0}"{% endif %} --tag "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA" .
    - |
      if [ -n "$CI_COMMIT_TAG" ]; then
        docker tag "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA" "$CI_REGISTRY_IMAGE:$CI_COMMIT_TAG"
        docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_TAG"
      elif [ "$CI_COMMIT_BRANCH" = "$CI_DEFAULT_BRANCH" ]; then
        docker tag "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA" "$CI_REGISTRY_IMAGE:latest"
        docker push "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA"
        docker push "$CI_REGISTRY_IMAGE:latest"
      fi
{%- endif %}

# Releases are cut by pushing a tag such as v1.2.3. The version comes from the tag.
.release:
  stage: release
  interruptible: false
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+/

release-notes:
  extends: .release
  script:
    - uvx git-cliff --latest --output release-notes.md
  artifacts:
    paths: [release-notes.md]
{%- if is_library %}

publish:
  extends: .release
  variables:
    UV_PUBLISH_URL: $CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/pypi
    UV_PUBLISH_USERNAME: gitlab-ci-token
    UV_PUBLISH_PASSWORD: $CI_JOB_TOKEN
  script:
    - uv build
    - uv publish
{%- endif %}

release:
  extends: .release
  image: registry.gitlab.com/gitlab-org/cli:latest
  needs:
    - job: release-notes
      artifacts: true
  script:
    - echo "Releasing $CI_COMMIT_TAG"
  release:
    tag_name: $CI_COMMIT_TAG
    description: release-notes.md
