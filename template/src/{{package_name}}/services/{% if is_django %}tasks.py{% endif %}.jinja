"""Background tasks: thin wrappers that run a use case outside the request cycle.

Enqueue with ``send_greeting.enqueue(name)``; ``just worker`` runs them.
"""

import logging

from django.tasks import task

from {{ package_name }}.services.greeting import greet

logger = logging.getLogger(__name__)


@task
def send_greeting(name: str) -> str:
    """Greet ``name``. An example task: replace it with real work such as sending email."""
    message = greet(name).message()
    logger.info("Greeting sent: %s", message)
    return message
