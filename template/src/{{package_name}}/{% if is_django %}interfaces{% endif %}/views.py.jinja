"""Web views."""

from typing import TYPE_CHECKING

from django.db import connection
from django.http import HttpRequest, HttpResponse, JsonResponse
from django.shortcuts import render
from django.views.decorators.http import require_http_methods

from {{ package_name }}.services.greeting import greet

if TYPE_CHECKING:
    from {{ package_name }}.interfaces.http import HtmxHttpRequest


@require_http_methods(["GET"])
def home(request: HtmxHttpRequest) -> HttpResponse:
    """Render the home page, or only the greeting partial for htmx requests."""
    greeting = greet(request.GET.get("name", ""))
    template = "home.html#greeting" if request.htmx else "home.html"
    return render(request, template, {"greeting": greeting})


@require_http_methods(["GET"])
def healthz(request: HttpRequest) -> JsonResponse:  # noqa: ARG001
    """Report liveness, including database connectivity."""
    with connection.cursor() as cursor:
        cursor.execute("SELECT 1")
    return JsonResponse({"status": "ok"})
