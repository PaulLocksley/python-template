"""Production settings. Verified in CI with ``manage.py check --deploy``."""

from django.core.exceptions import ImproperlyConfigured

from {{ package_name }}.config import INSECURE_SECRET_KEY

from .base import *

if SECRET_KEY == INSECURE_SECRET_KEY:
    msg = "SECRET_KEY must be set in production."
    raise ImproperlyConfigured(msg)

# WhiteNoise serves the collected static files, straight after the security middleware.
MIDDLEWARE.insert(1, "whitenoise.middleware.WhiteNoiseMiddleware")
STORAGES = {
    "default": {"BACKEND": "django.core.files.storage.FileSystemStorage"},
    "staticfiles": {"BACKEND": "whitenoise.storage.CompressedManifestStaticFilesStorage"},
}

# TLS is terminated by a reverse proxy that forwards the original scheme.
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
SECURE_SSL_REDIRECT = env.secure_ssl_redirect
SECURE_REDIRECT_EXEMPT = [r"^healthz/$"]
SECURE_HSTS_SECONDS = 60 * 60 * 24 * 365
SECURE_HSTS_INCLUDE_SUBDOMAINS = True
SECURE_HSTS_PRELOAD = True
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True

LOGGING["handlers"]["console"]["formatter"] = "json"
