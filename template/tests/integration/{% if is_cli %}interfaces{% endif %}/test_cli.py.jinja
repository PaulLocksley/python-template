from typer.testing import CliRunner

from {{ package_name }}.interfaces.cli import app

runner = CliRunner()


def test_hello_greets_the_given_name() -> None:
    """The hello command prints a greeting for its argument."""
    result = runner.invoke(app, ["hello", "Ada"])

    assert result.exit_code == 0
    assert result.output == "Hello, Ada!\n"


def test_hello_defaults_to_world() -> None:
    """Without an argument the hello command greets the world."""
    result = runner.invoke(app, ["hello"])

    assert result.output == "Hello, world!\n"
