import factory
from factory.django import DjangoModelFactory

from {{ package_name }}.data.users.models import User


class UserFactory(DjangoModelFactory):
    """Build users with unique usernames and a usable password."""

    class Meta:  # ty: ignore[incompatible-attribute-override]
        model = User
        skip_postgeneration_save = True

    username = factory.Sequence(lambda n: f"user{n}")
    email = factory.LazyAttribute(lambda user: f"{user.username}@example.org")
    password = factory.django.Password("password")
