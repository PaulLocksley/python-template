{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["frontend/src/**", "*.ts", "*.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 99
  },
{%- if is_tailwind %}
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
{%- endif %}
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
