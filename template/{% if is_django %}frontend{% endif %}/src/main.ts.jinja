{%- if is_bootstrap -%}
import "bootstrap/dist/css/bootstrap.min.css";
// Bootstrap's components (dropdowns, modals, collapse, ...) use event delegation,
// so they also work in content htmx swaps in later.
import "bootstrap";
{% endif -%}
import "./main.css";
import { flashSwappedContent } from "./flash";

// htmx is vendored and loaded by base.html; here we only react to its events.
document.body.addEventListener("htmx:afterSwap", (event) => {
  if (event.target instanceof HTMLElement) {
    flashSwappedContent(event.target);
  }
});
