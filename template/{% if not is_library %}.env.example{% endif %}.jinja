# Copy to .env for local overrides. Every variable is declared, typed and
# documented in src/{{ package_name }}/config.py.
{%- if is_django %}
# Development and tests work with no .env at all.

# SECRET_KEY=change-me
# DATABASE_URL=postgres://{{ package_name }}:{{ package_name }}@localhost:5432/{{ package_name }}
# ALLOWED_HOSTS=["example.org"]
# CSRF_TRUSTED_ORIGINS=["https://example.org"]
# SECURE_SSL_REDIRECT=true
# LOG_LEVEL=INFO
{%- else %}

# {{ package_name | upper }}_LOG_LEVEL=INFO
{%- endif %}
